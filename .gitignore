# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets / local config
.env

# Data & model artifacts (never commit) — root-anchored so src/feather/data/ is tracked
/data/
/datasets/
*.pt
*.pth
*.ckpt
*.npz
*.tar

# Experiment outputs (folder structure kept via .gitkeep, contents ignored)
runs/
outputs/*
!outputs/.gitkeep
logs/*
!logs/.gitkeep
*.log

# Paper build artifacts
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.out
paper/**/*.synctex.gz
paper/**/*.fdb_latexmk
paper/**/*.fls

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
